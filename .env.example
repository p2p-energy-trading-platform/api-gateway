PORT=3000
JWT_SECRET=your-secret-here
NODE_ENV=development

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=10

# Gateway
GATEWAY_BASE_URL=http://localhost:3000

# Downstream service gRPC addresses
MATCHING_ENGINE_URL=localhost:50051
ORDER_SERVICE_URL=localhost:50052
AUTH_SERVICE_URL=localhost:50053
NOTIFICATION_SERVICE_URL=localhost:50054
