# Application
NODE_ENV=development
SERVICE_NAME=api-gateway
SERVICE_VERSION=0.1.0
API_GATEWAY_PORT=8000

# HTTP
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# HTTP limits
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=10000

# CORS
CORS_ORIGINS=http://localhost:5173

# Redis
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=2000

# Rate limiting
# Proxy IPs/CIDRs allowed to set X-Forwarded-For (e.g. 10.0.0.0/8). false = use the socket IP.
TRUST_PROXY=false
RATE_LIMIT_HASH_SECRET=dev-only-rate-limit-secret

# Metrics (internal port, never publish it). In Docker set METRICS_HOST=0.0.0.0
METRICS_HOST=127.0.0.1
METRICS_PORT=9464

# Authentication
AUTH_ISSUER=http://auth-service:3000
AUTH_AUDIENCE=gridx-api
AUTH_JWKS_URI=http://auth-service:3000/.well-known/jwks.json
AUTH_ALLOWED_ALGORITHMS=EdDSA
AUTH_CLOCK_TOLERANCE_SECONDS=5
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_REQUEST_TIMEOUT_MS=2000

# Internal services
# ORDER_SERVICE_GRPC_TARGET=order-service:50052
# MARKET_SERVICE_GRPC_TARGET=market-service:50053
# TRADE_SERVICE_GRPC_TARGET=trade-service:50054
# WALLET_SERVICE_GRPC_TARGET=wallet-service:50055
# DEVICE_SERVICE_GRPC_TARGET=device-service:50056
# NOTIFICATION_SERVICE_GRPC_TARGET=notification-service:50057

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=gridx-api-gateway
KAFKA_GROUP_ID=gridx-api-gateway-dev

AUTH_SERVICE_GRPC_URL=http://auth-service:50051
GRPC_DEFAULT_TIMEOUT_MS=5000
GRPC_TLS_ENABLED=false
# GRPC_TLS_CA_PATH=/path/to/ca.crt
# GRPC_TLS_CERT_PATH=/path/to/client.crt
# GRPC_TLS_KEY_PATH=/path/to/client.key