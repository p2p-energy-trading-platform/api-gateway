{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "Fastify API Gateway for the GridX P2P Energy Trading Platform",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "lint": "oxlint -D correctness -D suspicious --vitest-plugin --deny-warnings src tests",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2p-energy-trading-platform/api-gateway.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/p2p-energy-trading-platform/api-gateway/issues"
  },
  "homepage": "https://github.com/p2p-energy-trading-platform/api-gateway#readme",
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.3.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.78.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "@confluentinc/kafka-javascript@1.10.0": true
  }
}
