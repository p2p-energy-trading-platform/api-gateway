{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "Fastify API Gateway for the GridX P2P Energy Trading Platform",
  "main": "dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "check-config": "tsx scripts/check-config.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/transport/redis/scripts', 'dist/transport/redis/scripts', { recursive: true })\"",
    "start": "node dist/main.js",
    "lint": "oxlint -D correctness -D suspicious -A no-async-endpoint-handlers --vitest-plugin --deny-warnings src test",
    "lint:fix": "oxlint -D correctness -D suspicious -A no-async-endpoint-handlers --vitest-plugin --fix src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2p-energy-trading-platform/api-gateway.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/p2p-energy-trading-platform/api-gateway/issues"
  },
  "homepage": "https://github.com/p2p-energy-trading-platform/api-gateway#readme",
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.10.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/websocket": "^11.3.0",
    "@p2p-energy-trading-platform/typescript-sdk": "github:p2p-energy-trading-platform/typescript-sdk#v1.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "env-schema": "^8.0.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "@p2p-energy-trading-platform/typescript-sdk": true,
    "@confluentinc/kafka-javascript@1.10.1": true,
    "esbuild@0.28.2": true
  }
}
